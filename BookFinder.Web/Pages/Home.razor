@page "/"
@inject BookFinder.Web.Services.BookFinderApiClient ApiClient

<PageTitle>BookFinder</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">BookFinder</h1>
        <p class="lead text-muted">Describe any book — author, title, year, keywords — and we'll find it.</p>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text" class="form-control"
                       placeholder="e.g. tolkien hobbit illustrated deluxe 1937"
                       @bind="_query" @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@_isLoading"
                       aria-label="Book search query" />
                <button class="btn btn-primary px-4" @onclick="SearchAsync"
                        disabled="@(_isLoading || string.IsNullOrWhiteSpace(_query))">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Search
                </button>
            </div>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            </div>
        </div>
    }

    @if (_results is not null && _results.Count == 0)
    {
        <div class="row justify-content-center">
            <div class="col-md-8 text-center text-muted">
                <p>No results found. Try a different query.</p>
            </div>
        </div>
    }

    @if (_results is { Count: > 0 })
    {
        <div class="row g-4">
            @foreach (var result in _results)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (result.CoverImageUrl is not null)
                        {
                            <img src="@result.CoverImageUrl" class="card-img-top" alt="Book cover"
                                 style="height:200px;object-fit:cover;" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height:200px;">
                                <span class="text-muted fs-1">📚</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title mb-1">@result.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                @result.Author
                                @if (result.FirstPublishYear.HasValue)
                                {
                                    <span class="ms-1">(@result.FirstPublishYear)</span>
                                }
                            </h6>
                            <p class="card-text small text-secondary">@result.Explanation</p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="@result.OpenLibraryUrl" target="_blank" rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-secondary">
                                View on Open Library
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private string _query = string.Empty;
    private bool _isLoading;
    private string? _errorMessage;
    private List<BookFinder.Web.Models.SearchResultDto>? _results;

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _isLoading) return;

        _isLoading = true;
        _errorMessage = null;
        _results = null;

        try
        {
            var response = await ApiClient.SearchAsync(_query.Trim());
            _results = response?.Results.ToList() ?? [];
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 502)
        {
            _errorMessage = "Open Library is currently unavailable. Please try again later.";
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 429)
        {
            _errorMessage = "Too many requests. Please wait a moment and try again.";
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 400)
        {
            _errorMessage = ex.Message ?? "Invalid query. Please enter at least one word.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode is not null)
        {
            _errorMessage = ex.Message ?? $"Request failed ({(int)ex.StatusCode!.Value}).";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _errorMessage = $"Could not reach the API — is it running on {ApiClient.BaseAddress}?";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }
}
